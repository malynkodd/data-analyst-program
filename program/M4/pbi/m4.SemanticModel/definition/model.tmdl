model Model
	culture: ru-RU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ru-RU
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["transactions","merchants","merchant_plan","mcc_categories","calendar","DataFolder"]

annotation PBI_ProTooling = ["DevMode"]

ref table transactions
ref table merchants
ref table merchant_plan
ref table mcc_categories
ref table calendar

ref cultureInfo ru-RU

