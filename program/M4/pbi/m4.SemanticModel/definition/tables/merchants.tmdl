	partition merchants = m
		mode: import
		source =
				let
				    Источник = Csv.Document(
				        File.Contents(DataFolder & "merchants.csv"),
				        [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Повышенные заголовки" = Table.PromoteHeaders(Источник, [PromoteAllScalars = true]),
				    #"Изменённый тип" = Table.TransformColumnTypes(#"Повышенные заголовки", {
				        {"merchant_id", Int64.Type},
				        {"merchant_name", type text},
				        {"city", type text},
				        {"address", type text}}, "en-US")
				in
				    #"Изменённый тип"

	annotation PBI_NavigationStepName = Навигация

	annotation PBI_ResultType = Table

