table merchants
	lineageTag: 301e3879-c8ee-4e64-911d-3fc3061a4ff9

	column merchant_id
		dataType: int64
		formatString: 0
		lineageTag: 7df860d8-3467-4bd5-9637-04658cd88540
		summarizeBy: none
