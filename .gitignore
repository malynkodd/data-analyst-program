
.claude/settings.local.json

# Локальные SQLite-базы, которые учащийся/автор строит из schema.sql +
# seed.sql (+ генераторы) — эталоны фиксируются кодом, не файлом базы.
*.db
__pycache__/
*.pyc

# Сгенерированный датасет M4: в репозитории — генератор и контрольная
# точка, а не данные (решение 22 `design/decisions.md`, «Что коммитится»).
program/M4/data/csv/
program/M4/data/csv_next/

# Сгенерированный датасет M5: в репозитории — генератор, скрипт эталонов и
# четыре эталонных CSV, а не сами данные (то же правило, что для M4;
# решение 29 `design/decisions.md`). Папка воспроизводится прогоном
# `generate_m5.py`, сходимость — по sha256 из `reference_answers.md`.
program/M5/data/raw/

# Сгенерированный датасет M6: то же правило (решение 29). Воспроизводится
# `generate_m6.py`, сходимость — по двум sha256 из `reference_answers.md`.
program/M6/data/raw/

# Сгенерированный датасет M8: то же правило (решение 29). Воспроизводится
# `generate_m8.py`, сходимость — по трём sha256 из `reference_answers.md`.
program/M8/data/raw/

# Сгенерированный датасет M11: то же правило (решение 29). Воспроизводится
# `generate_m11.py`, сходимость — по трём sha256 из `reference_answers.md`.
program/M11/data/raw/

# Сгенерированный датасет P1: то же правило (решение 29). Воспроизводится
# `generate_p1.py`, сходимость — по sha256 из `reference_answers.md`.
program/P1/data/raw/

# Сгенерированный датасет P2: то же правило (решение 29). Воспроизводится
# `generate_p2.py`, сходимость — по двум sha256 из `reference_answers.md`.
program/P2/data/raw/

# Сгенерированный датасет P5: то же правило (решение 29). Воспроизводится
# `generate_p5.py`, сходимость — по sha256 из README/`reference_answers.md`.
program/P5/data/raw/

# Сырой ЄДР для P4 (UO.zip, 326 858 701 байт на 2026-08-22, решение 35) —
# автор скачивает вручную (решение 36: robots.txt data.gov.ua запрещает
# AI-краулерам). Файл и распакованный реестр слишком велики для git и не
# коммитятся; sha256 фиксируется в data/README.md после выгрузки.
program/P4/data/raw/

# Локальное состояние проектов Power BI Desktop: кэш модели (`cache.abf`,
# до 260 КБ и переписывается каждым открытием) и настройки окна. Desktop
# пишет такой `.gitignore` сам, но измеренно — только в **новую папку вне
# репозитория**; в `program\M4\pbi` он его не создал (R4,
# `research/tools-gate.md`), поэтому строки живут здесь.
**/.pbi/

# Бинарный `.pbix`: не версионируется построчно, диффа не даёт. Формат
# модуля — PBIP с TMDL (`step-01.md`, 1.2). Файл может появиться от
# «Сохранить как» с типом по умолчанию — в репозиторий он не попадает.
*.pbix

# Выгрузки визуалов, которые делает учащийся на step-04.md: результат
# работы, а не артефакт репозитория. Проверка шага читает их с диска
# (`check_pbip.py --step 04 --exports`), эталоны лежат рядом в data/.
program/M4/pbi/export/

# Окружение модуля M5: ставится `python -m venv .venv` в step-01.md,
# 243 МБ и 22 пакета на машине автора. Воспроизводится одной командой,
# в репозитории не хранится.
.venv/
